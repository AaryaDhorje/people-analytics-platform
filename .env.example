# Copy to .env and fill in. Never commit .env.

# --- Database ---------------------------------------------------------------
# Local dev (docker-compose): use the value below as-is.
# Production: paste the Neon POOLED connection string and keep ?sslmode=require.
DATABASE_URL=postgresql+psycopg://people:people@localhost:5432/people_analytics

# --- App --------------------------------------------------------------------
ENV=local
# Comma-separated. Add the Vercel production origin before deploying.
CORS_ORIGINS=http://localhost:5173

# --- Demo auth --------------------------------------------------------------
# Single hardcoded demo user, bearer token only. Not real auth — stated in the README.
DEMO_BEARER_TOKEN=dev-demo-token-change-me

# --- Claude API (used from Phase 6 onward) ----------------------------------
ANTHROPIC_API_KEY=
MODEL_REASONING=claude-sonnet-5
MODEL_BULK=claude-haiku-4-5-20251001

# --- Local Postgres container (docker-compose reads these) ------------------
POSTGRES_USER=people
POSTGRES_PASSWORD=people
POSTGRES_DB=people_analytics
POSTGRES_PORT=5432
