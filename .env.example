# Copy to .env and fill in. Never commit .env.

# --- Database ---------------------------------------------------------------
# Local dev: the PostgreSQL 18 service already running on this machine. Replace
# the password with yours; the database is created once with
#   "C:\Program Files\PostgreSQL\18\bin\createdb.exe" -U postgres people_analytics
# Production (phase 7): paste the Neon POOLED connection string and keep
# ?sslmode=require on the end.
DATABASE_URL=postgresql+psycopg://postgres:CHANGE_ME@localhost:5432/people_analytics

# --- App --------------------------------------------------------------------
ENV=local
# Comma-separated exact origins. Add the Vercel production origin before deploying.
CORS_ORIGINS=http://localhost:5173

# Regex matched against Origin in addition to the list above. Vercel gives every preview
# deployment its own hostname, so an exact-match list can only ever cover production —
# without this the first preview build fails CORS and looks like a backend outage.
# For production set something like:
#   CORS_ORIGIN_REGEX=https://.*\.vercel\.app
CORS_ORIGIN_REGEX=

# --- Demo auth --------------------------------------------------------------
# Single hardcoded demo user, bearer token only. Not real auth — stated in the README.
DEMO_BEARER_TOKEN=dev-demo-token-change-me

# --- Claude API (used from Phase 6 onward) ----------------------------------
ANTHROPIC_API_KEY=
MODEL_REASONING=claude-sonnet-5
MODEL_BULK=claude-haiku-4-5-20251001

# --- docker-compose fallback (optional) -------------------------------------
# Only needed if you run Postgres in a container instead of using the local
# service — e.g. on a machine with no Postgres installed. Point DATABASE_URL at
# port 5433 if you run both at once, since the local service already holds 5432.
POSTGRES_USER=people
POSTGRES_PASSWORD=people
POSTGRES_DB=people_analytics
POSTGRES_PORT=5433
