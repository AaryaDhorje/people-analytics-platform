# Normalize line endings in the repository to LF. Without this, every commit from
# a Windows checkout emits a "LF will be replaced by CRLF" warning per file, and
# the backend deploys to Linux where CRLF in a shell script is a runtime error.
* text=auto eol=lf

# Binary — never touch these.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.woff binary
*.woff2 binary

# Generated. Collapse in diffs so a lockfile churn does not bury a real change.
package-lock.json linguist-generated=true -diff
